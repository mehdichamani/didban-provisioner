# Interface config (VLAN / Ethernet where unconfigured cameras reside)
VLAN_INTERFACE=eno1.400

# Mikrotik Router SSH settings
ROUTER_HOST=router.local
ROUTER_USER=admin
ROUTER_PASSWORD=
# Note: If password is empty, default SSH key / ~/.ssh/config is used
DHCP_SERVER_NAME=dhcp1

# Camera Defaults
CAMERA_PASSWORD=ChangeMe123!
IP_POOL_START=172.20.2.188
IP_POOL_END=172.20.2.220
