# ==============================================================================
# ⚙️ تنظیمات didban-provisioner
# ==============================================================================
# این ابزار اطلاعات NVRها، رمزهای NVR و لیست IPهای استفاده‌شده را مستقیماً
# از دیتابیس سامانه دیدبان (data/monitor.db) دریافت می‌کند.
# تنها تنظیمات زیر مختص لایه ۲ و شبکه میکروتیک است:

# کارت شبکه / VLAN که دوربین‌های جدید به آن متصل می‌شوند
VLAN_INTERFACE=eno1.400

# رمز عبور پیش‌فرض دوربین‌ها (جهت فعال‌سازی اولیه دوربین و اتصال آن به NVR)
CAMERA_PASSWORD=@Aa3603912!

# تنظیمات اتصال SSH به روتر میکروتیک
ROUTER_HOST=router-pishgaman
ROUTER_USER=
ROUTER_PASSWORD=
DHCP_SERVER_NAME=server1
IP_POOL_NAME=pool-cameras
